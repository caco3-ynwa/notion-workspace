    "import requests\n",
    "import pandas as pd\n",
    "\n",
    "account_id = 148037805\n",
    "\n",
    "url = f\"https://api.opendota.com/api/players/{account_id}/matches\"\n",
    "\n",
    "response = requests.get(url)\n",
    "response.raise_for_status()\n",
    "\n",
    "matches = response.json()\n",
    "\n",
    "df = pd.DataFrame(matches)\n",
    "\n",
    "df.head()"
   ]
  }
